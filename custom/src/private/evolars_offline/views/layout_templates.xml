<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Injeção de PWA no Head -->
    <template id="evolars_offline_pwa_head" inherit_id="website.layout" name="Evolars Offline PWA Meta">
        <xpath expr="//head" position="inside">
            <link rel="manifest" href="/site.webmanifest"/>
            <meta name="theme-color" content="#08090a"/>
            <meta name="mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
        </xpath>
    </template>

    <!-- 2. Status de Conectividade e Link Offline na Navegação Superior -->
    <template id="evolars_offline_nav_status" inherit_id="portal.placeholder_user_sign_in" name="Evolars Offline Nav Status">
        <xpath expr="." position="inside">
            <li class="nav-item d-flex align-items-center me-2">
                <a href="/slides/offline" class="nav-link py-1 px-2 d-flex align-items-center text-decoration-none" title="Acessar cursos salvos no aparelho">
                    <i class="fa fa-folder-open-o text-primary me-1"></i>
                    <span class="fw-semibold">Cursos Salvos</span>
                </a>
                <span id="evolars-network-status" class="evolars-status-pill evolars-status-online ms-1">
                    <span class="status-dot"></span>
                    <span>Online</span>
                </span>
            </li>
        </xpath>
    </template>

    <!-- 3. Botões de Ação Offline na Barra Lateral do Curso -->
    <template id="evolars_offline_course_sidebar_actions" inherit_id="website_slides.course_sidebar" name="Evolars Offline Sidebar Actions">
        <xpath expr="//div[contains(@class, 'o_wslides_course_sidebar')]" position="inside">
            <div class="mt-3 pt-3 border-top evolars-offline-actions-container">
                <div class="d-grid gap-2">
                    <button type="button"
                            t-att-data-channel-id="channel.id"
                            onclick="evolarsDownloadCourseOffline(this.dataset.channelId, this)"
                            class="btn btn-outline-primary btn-sm evolars-btn-download-offline fw-semibold">
                        <i class="fa fa-download me-1"></i> Estudar Offline (Salvar no Aparelho)
                    </button>
                    <a t-attf-href="/slides/channel/#{channel.id}/download_package"
                       class="btn btn-outline-secondary btn-sm evolars-btn-download-zip fw-semibold"
                       title="Baixar todas as apostilas em um único arquivo .ZIP para pendrive ou compartilhamento">
                        <i class="fa fa-file-archive-o me-1"></i> Baixar Pacote Completo (.ZIP)
                    </a>
                </div>
                <div class="small text-center mt-1" style="font-size: 11px; color: #475569;">
                    <i class="fa fa-bolt text-warning me-1"></i> Economize sua internet móvel
                </div>
            </div>
        </xpath>
    </template>

    <!-- 4. Hero Banner em /slides: Anúncio do Modo Offline & Diferencial Angola (WCAG AAA) -->
    <template id="evolars_courses_home_banner" inherit_id="website_slides.courses_home" name="Evolars Hero Offline Banner">
        <xpath expr="//section[contains(@class, 's_banner')]" position="replace">
            <section class="s_banner evolars-hero-banner py-5 text-white" data-snippet="s_banner">
                <div class="container">
                    <div class="row align-items-center gy-4">
                        <div class="col-lg-7">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="/evolars_offline/static/src/img/evolars_logo_horizontal_white.png" alt="Evolars Angola" class="evolars-hero-logo"/>
                                <span class="badge text-uppercase px-2 py-1" style="font-size: 11px; letter-spacing: 0.5px; font-weight: 700; background-color: #2563eb; color: #ffffff;">Plataforma Oficial</span>
                            </div>
                            <h1 class="display-5 fw-bold mb-3 lh-sm text-white">
                                Estude <span style="color: #60a5fa !important;">100% Offline</span> &amp; Economize Seus Dados Móveis
                            </h1>
                            <p class="lead mb-4" style="font-size: 1.15rem; color: #f8fafc !important; line-height: 1.6; font-weight: 400;">
                                Feito para Angola: sabemos o valor da sua internet. Baixe cursos técnicos completos de Cibersegurança, Programação, QA e Linux direto no telemóvel ou computador. Estude em qualquer lugar sem gastar saldo e sincronize seu progresso ao se reconectar.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <a href="#channels" class="btn btn-primary btn-lg shadow-sm fw-semibold" style="background-color: #2563eb; border-color: #2563eb; color: #ffffff;">
                                    <i class="fa fa-graduation-cap me-1"></i> Explorar Cursos
                                </a>
                                <a href="/slides/offline" class="btn btn-outline-light btn-lg fw-semibold" style="color: #ffffff; border-color: #ffffff;">
                                    <i class="fa fa-folder-open-o me-1"></i> Cursos Salvos no Aparelho
                                </a>
                                <a href="https://wa.me/5511930680941?text=Ol%C3%A1%2C+estou+acessando+a+plataforma+Evolars+Angola" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-lg fw-semibold" style="background-color: #15803d; border-color: #15803d; color: #ffffff;">
                                    <i class="fa fa-whatsapp me-1"></i> WhatsApp Oficial
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="card evolars-hero-card rounded-4 shadow-lg p-3 p-md-4">
                                <div class="d-flex align-items-center justify-content-between pb-3 mb-3" style="border-bottom: 1px solid #334155;">
                                    <span class="fw-bold text-uppercase small" style="color: #93c5fd; letter-spacing: 0.5px;"><i class="fa fa-shield me-1" style="color: #60a5fa;"></i> Nosso Diferencial</span>
                                    <span class="badge" style="background-color: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid #059669; font-weight: 700; font-size: 12px; padding: 5px 10px;">Zero Consumo</span>
                                </div>
                                <div class="d-flex flex-column gap-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="evolars-feature-icon">
                                            <i class="fa fa-mobile fa-2x"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">iPhone, Android e PC</h6>
                                            <p class="mb-0" style="font-size: 0.9rem; line-height: 1.4;">Instale como aplicativo (PWA) direto do Safari ou Chrome com 1 toque.</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="evolars-feature-icon">
                                            <i class="fa fa-file-archive-o fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">Pacote Completo (.ZIP)</h6>
                                            <p class="mb-0" style="font-size: 0.9rem; line-height: 1.4;">Baixe todas as apostilas em arquivo único para pendrive ou cartão de memória.</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="evolars-feature-icon">
                                            <i class="fa fa-refresh fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">Sincronização Automática</h6>
                                            <p class="mb-0" style="font-size: 0.9rem; line-height: 1.4;">Marque lições como concluídas sem internet; o portal sincroniza ao reconectar.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!-- 5. Banner Informativo em /slides/all -->
    <template id="evolars_courses_all_banner" inherit_id="website_slides.courses_all" name="Evolars All Courses Offline Banner">
        <xpath expr="//section[contains(@class, 's_banner')]" position="replace">
            <section class="s_banner evolars-all-courses-banner py-4 text-white" data-snippet="s_banner">
                <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <img src="/evolars_offline/static/src/img/evolars_logo_horizontal_white.png" alt="Evolars Angola" style="max-height: 32px; width: auto;"/>
                            <span class="badge text-uppercase" style="font-size: 10px; background-color: #2563eb; color: #ffffff;">Evolars Angola</span>
                        </div>
                        <h1 class="display-6 fw-bold mb-1 text-white">Catálogo de Cursos Técnicos</h1>
                        <p class="mb-0" style="color: #e2e8f0 !important; font-size: 0.95rem;">
                            Todos os cursos possuem suporte a download offline e pacote .ZIP para economizar seus dados móveis em Angola.
                        </p>
                    </div>
                    <div>
                        <a href="/slides/offline" class="btn btn-outline-light btn-sm fw-semibold" style="color: #ffffff; border-color: #ffffff;">
                            <i class="fa fa-folder-open-o me-1"></i> Acessar Cursos Salvos
                        </a>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!-- 6. Rodapé Oficial Evolars (WCAG AAA) -->
    <template id="evolars_footer_custom" inherit_id="website.layout" name="Evolars Angola Official Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo pt-5 pb-4">
                <div class="container">
                    <div class="row gy-4">
                        <!-- Coluna 1: Logo Evolars e Institucional -->
                        <div class="col-lg-5 col-md-6">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="/evolars_offline/static/src/img/evolars_logo_horizontal_white.png" alt="Evolars" style="max-height: 42px; width: auto;"/>
                            </div>
                            <p class="mb-3 lh-sm" style="color: #e2e8f0 !important; max-width: 420px; font-size: 0.92rem;">
