                    <div class="row align-items-center gy-4">
                        <div class="col-lg-7">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="/evolars_offline/static/src/img/evolars_logo_horizontal_white.png" alt="Evolars Angola" class="evolars-hero-logo"/>
                                <span class="badge text-uppercase px-2 py-1" style="font-size: 11px; letter-spacing: 0.5px; font-weight: 700; background-color: #2563eb; color: #ffffff;">Plataforma Oficial</span>
                            </div>
                            <h1 class="display-5 fw-bold mb-3 lh-sm text-white">
                                Estude <span style="color: #60a5fa !important;">100% Offline</span> &amp; Economize Seus Dados Móveis
                            </h1>
                            <p class="lead mb-4" style="font-size: 1.15rem; color: #f8fafc !important; line-height: 1.6; font-weight: 400;">
                                Feito para Angola: sabemos o valor da sua internet. Baixe cursos técnicos completos de Cibersegurança, Programação, QA e Linux direto no telemóvel ou computador. Estude em qualquer lugar sem gastar saldo e sincronize seu progresso ao se reconectar.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <a href="#channels" class="btn btn-primary btn-lg shadow-sm fw-semibold" style="background-color: #2563eb; border-color: #2563eb; color: #ffffff;">
                                    <i class="fa fa-graduation-cap me-1"></i> Explorar Cursos
                                </a>
                                <a href="/slides/offline" class="btn btn-outline-light btn-lg fw-semibold" style="color: #ffffff; border-color: #ffffff;">
                                    <i class="fa fa-folder-open-o me-1"></i> Cursos Salvos no Aparelho
                                </a>
                                <a href="https://wa.me/5511930680941?text=Ol%C3%A1%2C+estou+acessando+a+plataforma+Evolars+Angola" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-lg fw-semibold" style="background-color: #15803d; border-color: #15803d; color: #ffffff;">
                                    <i class="fa fa-whatsapp me-1"></i> WhatsApp Oficial
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="card evolars-hero-card rounded-4 shadow-lg p-3 p-md-4">
                                <div class="d-flex align-items-center justify-content-between pb-3 mb-3" style="border-bottom: 1px solid #334155;">
                                    <span class="fw-bold text-uppercase small" style="color: #93c5fd; letter-spacing: 0.5px;"><i class="fa fa-shield me-1" style="color: #60a5fa;"></i> Nosso Diferencial</span>
                                    <span class="badge" style="background-color: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid #059669; font-weight: 700; font-size: 12px; padding: 5px 10px;">Zero Consumo</span>
                                </div>
                                <div class="d-flex flex-column gap-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="evolars-feature-icon">
                                            <i class="fa fa-mobile fa-2x"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">iPhone, Android e PC</h6>
                                            <p class="mb-0" style="font-size: 0.9rem; line-height: 1.4;">Instale como aplicativo (PWA) direto do Safari ou Chrome com 1 toque.</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="evolars-feature-icon">
                                            <i class="fa fa-file-archive-o fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">Pacote Completo (.ZIP)</h6>
                                            <p class="mb-0" style="font-size: 0.9rem; line-height: 1.4;">Baixe todas as apostilas em arquivo único para pendrive ou cartão de memória.</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="evolars-feature-icon">
                                            <i class="fa fa-refresh fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">Sincronização Automática</h6>
                                            <p class="mb-0" style="font-size: 0.9rem; line-height: 1.4;">Marque lições como concluídas sem internet; o portal sincroniza ao reconectar.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <div id="channels" class="o_wslides_channels_anchor" style="scroll-margin-top: 80px;"></div>
        </xpath>
    </template>

    <!-- 5. Banner Informativo em /slides/all -->
    <template id="evolars_courses_all_banner" inherit_id="website_slides.courses_all" name="Evolars All Courses Offline Banner">
        <xpath expr="//section[contains(@class, 's_banner')]" position="replace">
