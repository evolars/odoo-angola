                            </h6>
                            <ul class="list-unstyled small d-flex flex-column gap-2 text-secondary">
                                <li><a href="/slides" class="text-decoration-none text-secondary"><i class="fa fa-book me-1 text-primary"></i> Portal de Cursos</a></li>
                                <li><a href="/slides/all" class="text-decoration-none text-secondary"><i class="fa fa-list me-1 text-primary"></i> Catálogo Completo</a></li>
                                <li><a href="/slides/offline" class="text-decoration-none text-light fw-bold"><i class="fa fa-bolt me-1 text-warning"></i> Cursos Salvos (Modo Offline)</a></li>
                                <li><a href="/slides/all/tag/ciberseguranca-6" class="text-decoration-none text-secondary"><i class="fa fa-shield me-1 text-primary"></i> Cibersegurança</a></li>
                                <li><a href="/slides/all/tag/engenharia-de-software-5" class="text-decoration-none text-secondary"><i class="fa fa-code me-1 text-primary"></i> Engenharia de Software</a></li>
                                <li><a href="/slides/all/tag/qa-automacao-de-testes-4" class="text-decoration-none text-secondary"><i class="fa fa-check-circle me-1 text-primary"></i> QA &amp; Testes</a></li>
                            </ul>
                        </div>

                        <!-- Coluna 3: Contatos Oficiais Evolars -->
                        <div class="col-lg-4 col-md-12">
                            <h6 class="text-uppercase fw-bold text-light mb-3" style="letter-spacing: 0.5px; font-size: 13px;">
                                Contatos &amp; Atendimento
                            </h6>
                            <ul class="list-unstyled small d-flex flex-column gap-2 text-secondary mb-3">
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa fa-whatsapp text-success fa-lg"></i>
                                    <a href="https://wa.me/5511930680941?text=Ol%C3%A1%2C+gostaria+de+falar+com+a+Evolars+Angola" target="_blank" rel="noopener noreferrer" class="text-white text-decoration-none fw-bold">
                                        +55 (11) 93068-0941
                                    </a>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa fa-envelope text-primary fa-fw"></i>
                                    <a href="mailto:angola@evolars.com.br" class="text-secondary text-decoration-none">
