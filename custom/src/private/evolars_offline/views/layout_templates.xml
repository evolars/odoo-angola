<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Injeção de PWA no Head -->
    <template id="evolars_offline_pwa_head" inherit_id="website.layout" name="Evolars Offline PWA Meta">
        <xpath expr="//head" position="inside">
            <link rel="manifest" href="/site.webmanifest"/>
            <meta name="theme-color" content="#08090a"/>
            <meta name="mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
        </xpath>
    </template>

    <!-- 2. Status de Conectividade e Link Offline na Navegação Superior -->
    <template id="evolars_offline_nav_status" inherit_id="portal.placeholder_user_sign_in" name="Evolars Offline Nav Status">
        <xpath expr="." position="inside">
            <li class="nav-item d-flex align-items-center me-2">
                <a href="/slides/offline" class="nav-link py-1 px-2 d-flex align-items-center text-decoration-none" title="Acessar cursos salvos no aparelho">
                    <i class="fa fa-folder-open-o text-primary me-1"></i>
                    <span>Cursos Salvos</span>
                </a>
                <span id="evolars-network-status" class="evolars-status-pill evolars-status-online ms-1">
                    <span class="status-dot"></span>
                    <span>Online</span>
                </span>
            </li>
        </xpath>
    </template>

    <!-- 3. Botões de Ação Offline na Barra Lateral do Curso -->
    <template id="evolars_offline_course_sidebar_actions" inherit_id="website_slides.course_sidebar" name="Evolars Offline Sidebar Actions">
        <xpath expr="//div[contains(@class, 'o_wslides_course_sidebar')]" position="inside">
            <div class="mt-3 pt-3 border-top evolars-offline-actions-container">
                <div class="d-grid gap-2">
                    <button type="button"
                            t-att-data-channel-id="channel.id"
                            onclick="evolarsDownloadCourseOffline(this.dataset.channelId, this)"
                            class="btn btn-outline-primary btn-sm evolars-btn-download-offline">
                        <i class="fa fa-download me-1"></i> Estudar Offline (Salvar no Aparelho)
                    </button>
                    <a t-attf-href="/slides/channel/#{channel.id}/download_package"
                       class="btn btn-outline-secondary btn-sm evolars-btn-download-zip"
                       title="Baixar todas as apostilas em um único arquivo .ZIP para pendrive ou compartilhamento">
                        <i class="fa fa-file-archive-o me-1"></i> Baixar Pacote Completo (.ZIP)
                    </a>
                </div>
                <div class="small text-muted text-center mt-1" style="font-size: 11px;">
                    <i class="fa fa-bolt text-warning me-1"></i> Economize sua internet móvel
                </div>
            </div>
        </xpath>
    </template>

    <!-- 4. Hero Banner em /slides: Anúncio do Modo Offline & Diferencial Angola -->
    <template id="evolars_courses_home_banner" inherit_id="website_slides.courses_home" name="Evolars Hero Offline Banner">
        <xpath expr="//section[contains(@class, 's_banner')]" position="replace">
            <section class="s_banner evolars-hero-banner py-5 text-white" data-snippet="s_banner">
                <div class="container">
                    <div class="row align-items-center gy-4">
                        <div class="col-lg-7">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <img src="/evolars_offline/static/src/img/logo_voz_no_papel_white.png" alt="Voz no Papel Editorial" class="evolars-hero-logo"/>
                                <span class="badge bg-primary text-uppercase px-2 py-1" style="font-size: 11px; letter-spacing: 0.5px; font-weight: 600;">Evolars Angola</span>
                            </div>
                            <h1 class="display-5 fw-bold mb-3 lh-sm">
                                Estude <span class="text-primary">100% Offline</span> &amp; Economize Seus Dados Móveis
                            </h1>
                            <p class="lead text-light mb-4" style="font-size: 1.1rem; opacity: 0.92;">
                                Feito para Angola: sabemos o valor da sua internet. Baixe cursos técnicos completos de Cibersegurança, Programação, QA e Linux direto no telemóvel ou computador. Estude em qualquer lugar sem gastar saldo e sincronize seu progresso ao se reconectar.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <a href="#channels" class="btn btn-primary btn-lg shadow-sm">
                                    <i class="fa fa-graduation-cap me-1"></i> Explorar Cursos
                                </a>
                                <a href="/slides/offline" class="btn btn-outline-light btn-lg">
                                    <i class="fa fa-folder-open-o me-1"></i> Cursos Salvos no Aparelho
                                </a>
                                <a href="https://wa.me/5511930680941?text=Ol%C3%A1%2C+estou+acessando+a+plataforma+Evolars+Angola" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-lg">
                                    <i class="fa fa-whatsapp me-1"></i> WhatsApp Oficial
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="card bg-dark bg-opacity-75 border border-secondary border-opacity-25 rounded-4 shadow-lg p-3 p-md-4 text-white">
                                <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom border-secondary border-opacity-25">
                                    <span class="fw-bold text-uppercase small text-muted"><i class="fa fa-shield text-primary me-1"></i> Nosso Diferencial</span>
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1">Zero Consumo</span>
                                </div>
                                <div class="d-flex flex-column gap-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="evolars-feature-icon">
                                            <i class="fa fa-mobile fa-2x text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">iPhone, Android e PC</h6>
                                            <p class="small text-muted mb-0">Instale como aplicativo (PWA) direto do Safari ou Chrome com 1 toque.</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="evolars-feature-icon">
                                            <i class="fa fa-file-archive-o fa-lg text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">Pacote Completo (.ZIP)</h6>
                                            <p class="small text-muted mb-0">Baixe todas as apostilas em arquivo único para pendrive ou cartão de memória.</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="evolars-feature-icon">
                                            <i class="fa fa-refresh fa-lg text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold">Sincronização Automática</h6>
                                            <p class="small text-muted mb-0">Marque lições como concluídas sem internet; o portal sincroniza ao reconectar.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!-- 5. Banner Informativo em /slides/all -->
    <template id="evolars_courses_all_banner" inherit_id="website_slides.courses_all" name="Evolars All Courses Offline Banner">
        <xpath expr="//section[contains(@class, 's_banner')]" position="replace">
            <section class="s_banner evolars-all-courses-banner py-4 text-white" data-snippet="s_banner">
                <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <img src="/evolars_offline/static/src/img/logo_voz_no_papel_white.png" alt="Voz no Papel Editorial" style="max-height: 28px;"/>
                            <span class="badge bg-primary text-uppercase" style="font-size: 10px;">Evolars Angola</span>
                        </div>
                        <h1 class="display-6 fw-bold mb-1">Catálogo de Cursos Técnicos</h1>
                        <p class="text-light mb-0 small" style="opacity: 0.9;">
                            Todos os cursos possuem suporte a download offline e pacote .ZIP para economizar seus dados móveis em Angola.
                        </p>
                    </div>
                    <div>
                        <a href="/slides/offline" class="btn btn-outline-light btn-sm">
                            <i class="fa fa-folder-open-o me-1"></i> Acessar Cursos Salvos
                        </a>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!-- 6. Rodapé Oficial Evolars + Voz no Papel Editorial -->
