<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Injeção de PWA no Head -->
    <template id="evolars_offline_pwa_head" inherit_id="website.layout" name="Evolars Offline PWA Meta">
        <xpath expr="//head" position="inside">
            <link rel="manifest" href="/site.webmanifest"/>
            <meta name="theme-color" content="#08090a"/>
            <meta name="mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
        </xpath>
    </template>

    <!-- 2. Status de Conectividade e Link Offline na Navegação Superior (Desktop) -->
    <template id="evolars_offline_nav_status" inherit_id="portal.placeholder_user_sign_in" name="Evolars Offline Nav Status">
        <xpath expr="." position="inside">
            <li class="nav-item d-flex align-items-center me-2">
                <a href="/slides/offline" class="btn btn-sm btn-outline-primary py-1 px-2 d-flex align-items-center gap-1 fw-bold evolars-desktop-offline-btn" title="Acessar cursos salvos no aparelho (Modo Offline)" style="color: #1d4ed8; border-color: #1d4ed8; font-size: 0.88rem;">
                    <i class="fa fa-folder-open-o"></i>
                    <span>Cursos Salvos</span>
                </a>
                <span id="evolars-network-status" class="evolars-status-pill evolars-status-online ms-1">
                    <span class="status-dot"></span>
                    <span>Online</span>
                </span>
            </li>
        </xpath>
    </template>

    <!-- 2.1 Botão de Cursos Salvos no Cabeçalho Mobile (Visível em todas as páginas) -->
    <template id="evolars_mobile_offline_nav_button" inherit_id="website.template_header_mobile" name="Evolars Mobile Header Offline Button">
        <xpath expr="//ul[contains(@class, 'o_header_mobile_buttons_wrap')]" position="inside">
            <li class="nav-item d-flex align-items-center">
                <a href="/slides/offline" class="btn btn-sm evolars-mobile-header-offline-btn d-flex align-items-center gap-1 py-1 px-2 fw-bold text-white shadow-sm" style="background-color: #1d4ed8; border-color: #1d4ed8; font-size: 12px; border-radius: 6px;" title="Cursos Salvos no Aparelho">
                    <i class="fa fa-folder-open-o"></i>
                    <span>Salvos</span>
                </a>
            </li>
        </xpath>
    </template>

    <!-- 2.2 Botão de Cursos Salvos na Barra do Curso (Desktop e Mobile) -->
    <template id="evolars_course_nav_offline_btn" inherit_id="website_slides.course_nav" name="Evolars Course Nav Offline Link">
        <xpath expr="//div[contains(@class, 'col-md-4') and contains(@class, 'd-none')]" position="before">
            <div class="col-auto d-none d-md-flex align-items-center">
                <a href="/slides/offline" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1 fw-semibold text-white" style="border-color: rgba(255,255,255,0.4);" title="Acessar cursos salvos no aparelho">
                    <i class="fa fa-folder-open-o"></i>
                    <span>Cursos Salvos</span>
                </a>
            </div>
        </xpath>
    </template>

    <!-- 3. Exigência de Login / Conta Cadastrada para Participação no Curso -->
    <template id="evolars_course_join_login_prompt" inherit_id="website_slides.course_join" name="Evolars Course Join Login Prompt">
        <xpath expr="//div[contains(@class, 'o_wslides_js_course_join')]" position="replace">
            <div class="o_wslides_js_course_join flex-grow-1 d-grid">
                <t t-if="env.user._is_public()">
                    <a role="button" class="btn btn-primary btn-block fw-bold shadow-sm py-2 evolars-btn-auth-join"
                       t-attf-href="/web/login?redirect=#{request.httprequest.path}"
                       title="Iniciar Sessão ou Criar Conta para participar deste curso"
                       style="background-color: #1d4ed8; border-color: #1d4ed8; color: #ffffff !important; font-size: 0.95rem;">
                        <i class="fa fa-sign-in me-1"></i>
                        <span>Iniciar Sessão para Participar</span>
                    </a>
                    <a t-attf-href="/web/signup?redirect=#{request.httprequest.path}"
                       class="small text-center mt-2 fw-semibold evolars-signup-link"
                       style="color: #1d4ed8 !important; text-decoration: underline;">
                        Não tem conta? Cadastre-se grátis
                    </a>
                </t>
                <t t-elif="not channel.is_member">
                    <a role="button" class="btn btn-primary btn-block o_wslides_js_course_join_link fw-bold py-2"
                       title="Inscrever-se no Curso" aria-label="Inscrever-se no Curso" href="#"
                       t-att-data-channel-id="channel.id"
                       t-att-data-channel-enroll="channel.enroll"
                       style="background-color: #1d4ed8; border-color: #1d4ed8; color: #ffffff !important;">
                        <i class="fa fa-graduation-cap me-1"></i>
                        <span class="cta-title">Inscrever-se no Curso</span>
                    </a>
                </t>
                <t t-else="">
                    <div class="alert alert-success py-2 px-3 mb-0 text-center fw-bold small rounded-3"
                         style="background-color: #dcfce7; color: #14532d; border: 1px solid #86efac;">
                        <i class="fa fa-check-circle me-1"></i> Você está inscrito neste curso
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <!-- 3.1 Botões de Ação Offline na Barra Lateral do Curso -->
    <template id="evolars_offline_course_sidebar_actions" inherit_id="website_slides.course_sidebar" name="Evolars Offline Sidebar Actions">
        <xpath expr="//div[contains(@class, 'o_wslides_course_sidebar')]" position="inside">
            <div class="mt-3 pt-3 border-top evolars-offline-actions-container">
                <div class="d-grid gap-2">
                    <t t-if="env.user._is_public()">
                        <a t-attf-href="/web/login?redirect=#{request.httprequest.path}"
                           class="btn btn-outline-primary btn-sm evolars-btn-download-offline fw-semibold"
                           title="Inicie sessão para salvar este curso offline no aparelho">
                            <i class="fa fa-download me-1"></i> Estudar Offline (Salvar no Aparelho)
                        </a>
                    </t>
                    <t t-else="">
                        <button type="button"
                                t-att-data-channel-id="channel.id"
                                onclick="evolarsDownloadCourseOffline(this.dataset.channelId, this)"
                                class="btn btn-outline-primary btn-sm evolars-btn-download-offline fw-semibold">
                            <i class="fa fa-download me-1"></i> Estudar Offline (Salvar no Aparelho)
                        </button>
                    </t>
                </div>
                <div class="small text-center mt-1" style="font-size: 11px; color: #334155;">
                    <i class="fa fa-bolt text-warning me-1"></i> Economize sua internet móvel em Angola
                </div>
            </div>
        </xpath>
    </template>

    <!-- 4. Hero Banner em /slides: Anúncio do Modo Offline & Diferencial Angola (WCAG AAA) -->
    <template id="evolars_courses_home_banner" inherit_id="website_slides.courses_home" name="Evolars Hero Offline Banner">
