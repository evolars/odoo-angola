    <!-- 9. Página Biblioteca de Cursos Salvos (/slides/offline) -->
    <template id="offline_library_template" name="Meus Cursos Salvos (Offline)">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h2 class="mb-0 font-weight-bold" style="color: #0f172a;">Meus Cursos Salvos</h2>
                            <span class="badge" style="background-color: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; font-weight: 700;">Modo Offline</span>
                        </div>
                        <p class="mb-0" style="color: #334155; font-size: 0.95rem;">
                            Cursos e apostilas salvos na memória do seu aparelho para estudo com zero consumo de internet móvel em Angola.
                        </p>
                    </div>
                    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
                        <a href="/slides/all" class="btn btn-primary btn-sm fw-semibold" style="background-color: #2563eb; border-color: #2563eb; color: #ffffff;">
                            <i class="fa fa-book me-1"></i> Explorar Catálogo
                        </a>
                    </div>
                </div>

                <!-- Campo de Pesquisa Rápida nos Cursos Salvos -->
                <div class="row mb-4">
                    <div class="col-md-6 col-lg-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0" style="color: #64748b;">
                                <i class="fa fa-search"></i>
                            </span>
                            <input type="text" id="evolars-offline-search" class="form-control border-start-0" placeholder="Pesquisar cursos ou lições..." oninput="window.evolarsFilterOfflineCourses &amp;&amp; window.evolarsFilterOfflineCourses(this.value)" style="color: #0f172a; font-weight: 500;"/>
                        </div>
                    </div>
                </div>

                <div id="evolars-offline-library-list" class="row align-items-start">
                    <t t-if="channels">
                        <t t-foreach="channels" t-as="c">
                            <t t-set="doc_slides" t-value="c.slide_ids.filtered(lambda s: s.slide_category == 'document' and s.is_published).sorted(lambda s: s.sequence)"/>
                            <div class="col-md-6 col-lg-4 mb-4 evolars-offline-item" t-att-data-channel-id="c.id">
                                <div class="card shadow-sm border evolars-offline-course-card" t-att-data-course-name="c.name" style="border-color: #cbd5e1 !important; border-radius: 10px;">
                                    <div class="card-body p-3 p-md-4">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                                <span class="badge evolars-status-tag" t-att-id="'course-status-' + str(c.id)" style="background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; font-weight: 600;">
                                                    <i class="fa fa-cloud me-1"></i>Catálogo Online
                                                </span>
                                                <span class="badge" style="background-color: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; font-weight: 700;">
                                                    <t t-esc="len(doc_slides)"/> apostilas
                                                </span>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary btn-sm evolars-action-save-btn py-1 px-2"
                                                    t-att-id="'save-btn-' + str(c.id)"
                                                    t-att-data-channel-id="c.id"
                                                    onclick="event.stopPropagation(); window.evolarsDownloadCourseOffline(this.dataset.channelId, this)"
                                                    title="Salvar todas as apostilas no aparelho para leitura offline sem gastar dados">
                                                <i class="fa fa-download"></i>
                                            </button>
                                        </div>

                                        <div class="evolars-course-title-toggle d-flex justify-content-between align-items-start gap-2 cursor-pointer mt-2"
                                             role="button"
                                             tabindex="0"
                                             t-att-id="'course-header-' + str(c.id)"
                                             t-att-onclick="'window.evolarsToggleCourseSlides(' + str(c.id) + ')'"
                                             t-att-onkeydown="'if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault(); window.evolarsToggleCourseSlides(' + str(c.id) + ');}'"
                                             aria-expanded="false"
                                             t-att-aria-controls="'offline-slides-list-' + str(c.id)">
                                            <h5 class="card-title font-weight-bold mb-0 evolars-course-title text-break" style="color: #0f172a; font-weight: 700;">
                                                <t t-esc="c.name"/>
                                            </h5>
                                            <span class="evolars-toggle-chevron ms-1 flex-shrink-0 text-primary pt-1" t-att-id="'course-chevron-' + str(c.id)">
                                                <i class="fa fa-chevron-down"></i>
                                            </span>
                                        </div>

                                        <p class="small mb-0 mt-2 text-muted" style="color: #475569 !important; line-height: 1.5;">
                                            <t t-if="c.description">
                                                <t t-esc="c.description[:110] + ('...' if len(c.description) > 110 else '')"/>
                                            </t>
                                            <t t-else="">
                                                Capacitação técnica profissional com apostilas digitais e leitura integrada no app.
                                            </t>
                                        </p>

                                        <div t-att-id="'offline-slides-list-' + str(c.id)" class="d-none mt-3 pt-3 border-top evolars-slides-collapse">
                                            <ul class="list-group list-group-flush">
                                                <t t-foreach="doc_slides" t-as="s">
                                                    <li class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center py-2 px-0 bg-transparent border-bottom gap-2">
                                                        <div class="d-flex align-items-center text-break me-2" style="max-width: 70%;">
                                                            <i class="fa fa-file-pdf-o text-danger me-2" style="font-size: 1.1rem;"></i>
                                                            <span class="fw-semibold" style="color: #0f172a; font-size: 0.88rem;"><t t-esc="s.name"/></span>
                                                        </div>
                                                        <div class="d-flex gap-1 flex-shrink-0 align-self-end align-self-sm-center">
                                                            <button type="button" class="btn btn-sm btn-primary py-1 px-2 fw-bold evolars-btn-read-app"
                                                                    t-att-data-slide-id="s.id"
                                                                    t-att-data-slide-name="s.name"
                                                                    t-att-data-channel-id="c.id"
                                                                    onclick="window.evolarsOpenLessonInApp(this.dataset.slideId, this.dataset.slideName, this.dataset.channelId)"
                                                                    style="background-color: #1d4ed8; border-color: #1d4ed8; font-size: 12px;">
                                                                <i class="fa fa-eye me-1"></i> Estudar no App
                                                            </button>
                                                        </div>
                                                    </li>
                                                </t>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="col-12 text-center py-5">
                            <span class="fa fa-spinner fa-spin fa-2x text-primary"></span>
                            <p class="mt-2" style="color: #334155; font-size: 1rem;">Carregando cursos no seu aparelho...</p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- 10. Modal do Leitor Integrado no App (Leitura Exclusiva sem Download Externo) -->
    <template id="evolars_inapp_viewer_modal_template" inherit_id="website.layout" name="Evolars In-App Document Viewer">
        <xpath expr="//footer | //div[@id='footer']" position="after">
            <div id="evolars-inapp-viewer-modal" class="d-none evolars-viewer-root" role="dialog" aria-modal="true" aria-labelledby="evolars-viewer-title">
                <div class="evolars-viewer-overlay" onclick="window.evolarsCloseInAppViewer()"></div>
                <div class="evolars-viewer-window">
                    <div class="evolars-viewer-header d-flex justify-content-between align-items-center px-3 py-2">
                        <div class="d-flex align-items-center gap-2 text-truncate me-2">
                            <i class="fa fa-book" style="color: #60a5fa; font-size: 1.1rem;"></i>
                            <h5 id="evolars-viewer-title" class="mb-0 text-truncate fw-bold text-white" style="font-size: 0.95rem;"></h5>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <button type="button" class="btn btn-sm evolars-viewer-ctrl-btn" onclick="window.evolarsViewerZoom(-0.2)" title="Diminuir Zoom">
                                <i class="fa fa-search-minus"></i>
                            </button>
                            <button type="button" class="btn btn-sm evolars-viewer-ctrl-btn" onclick="window.evolarsViewerZoom(0.2)" title="Aumentar Zoom">
                                <i class="fa fa-search-plus"></i>
                            </button>
                            <button type="button" class="btn btn-sm evolars-viewer-ctrl-btn" onclick="window.evolarsViewerToggleFullscreen()" title="Tela Inteira">
                                <i class="fa fa-expand"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-danger fw-bold ms-2 py-1 px-3" onclick="window.evolarsCloseInAppViewer()" title="Fechar Leitor">
                                <i class="fa fa-times me-1"></i> Fechar
                            </button>
                        </div>
                    </div>

                    <div class="evolars-viewer-body" id="evolars-viewer-body">
                        <div id="evolars-viewer-loading" class="text-center py-5">
                            <span class="fa fa-circle-o-notch fa-spin fa-3x" style="color: #38bdf8;"></span>
                            <p class="text-white mt-3 fw-semibold">Carregando conteúdo no leitor seguro...</p>
                        </div>
                        <div id="evolars-viewer-canvas-wrap" class="d-none text-center">
                            <canvas id="evolars-viewer-canvas" class="shadow-lg"></canvas>
                        </div>
                    </div>

                    <div class="evolars-viewer-footer d-flex justify-content-between align-items-center px-3 py-2">
                        <button type="button" id="evolars-viewer-btn-prev" class="btn btn-sm btn-primary fw-bold" onclick="window.evolarsViewerPrevPage()">
                            <i class="fa fa-chevron-left me-1"></i> Anterior
                        </button>
                        <div class="text-white fw-bold" style="font-size: 0.9rem;">
                            Página <span id="evolars-viewer-curr-page">1</span> de <span id="evolars-viewer-total-pages">1</span>
                        </div>
                        <button type="button" id="evolars-viewer-btn-next" class="btn btn-sm btn-primary fw-bold" onclick="window.evolarsViewerNextPage()">
                            Próxima <i class="fa fa-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
