                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- 8. Botão Flutuante de WhatsApp -->
    <template id="evolars_whatsapp_floating_btn" inherit_id="website.layout" name="Evolars WhatsApp Floating Button">
        <xpath expr="//body" position="inside">
            <a href="https://wa.me/5511930680941?text=Ol%C3%A1%2C+estou+acessando+a+plataforma+Evolars+Angola"
               target="_blank"
               rel="noopener noreferrer"
               class="evolars-whatsapp-floating"
               aria-label="Fale conosco no WhatsApp"
               title="Falar com a Evolars no WhatsApp (+55 11 93068-0941)">
                <i class="fa fa-whatsapp"></i>
                <span class="d-none d-sm-inline ms-1">WhatsApp</span>
