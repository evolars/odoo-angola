                                    <i class="fa fa-envelope text-primary fa-fw"></i>
                                    <a href="mailto:contato@evolars.com.br" class="text-secondary text-decoration-none">
                                        contato@evolars.com.br
                                    </a>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa fa-globe text-primary fa-fw"></i>
                                    <a href="https://evolars.com.br" target="_blank" rel="noopener noreferrer" class="text-secondary text-decoration-none">
                                        evolars.com.br
                                    </a>
                                    <span class="text-muted">•</span>
                                    <a href="https://voznopapeleditorial.com.br" target="_blank" rel="noopener noreferrer" class="text-secondary text-decoration-none">
                                        voznopapeleditorial.com.br
                                    </a>
                                </li>
                            </ul>
                            <div class="d-flex gap-2">
                                <a href="https://wa.me/5511930680941?text=Ol%C3%A1%2C+gostaria+de+falar+com+a+Evolars+Angola" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success">
                                    <i class="fa fa-whatsapp me-1"></i> WhatsApp Oficial
                                </a>
                                <a href="https://evolars.com.br" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
