<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="evolars_angola_header_footer" inherit_id="website.layout" name="Evolars Angola Layout Header &amp; Footer" priority="50">
        <xpath expr="//header[@id='top']" position="replace">
            <header id="top" class="evolars-header-angola o_no_autohide_menu" data-name="Evolars Header">
                <link type="text/css" rel="stylesheet" href="/evolars_angola_theme/static/src/css/evolars_angola_theme.css"/>
                <div class="evolars-header-container">
                    <ul id="top_menu" class="top_menu d-none"/>
                    <a class="evolars-brand-angola" href="/slides" aria-label="Evolars Angola">
                        <img src="/evolars_angola_theme/static/src/img/evolars_symbol_white.png" alt="Evolars Logo"/>
                        <div class="evolars-brand-title">
                            <span class="evolars-brand-name">EVOLARS ANGOLA</span>
                            <span class="evolars-brand-sub">Educação &amp; Tecnologia</span>
                        </div>
                    </a>

                    <nav class="evolars-nav-angola" aria-label="Navegação Principal">
                        <a href="/slides">Cursos</a>
                        <a href="/slides/all">Todas as Formações</a>
                        <a class="evolars-parent-badge" href="https://evolars.com.br" target="_blank" rel="noopener noreferrer" title="Ir para o site oficial da Evolars">
                            Uma iniciativa <strong>Evolars</strong> ↗
                        </a>
                        <t t-if="request.env.user._is_public()">
                            <a href="/web/login" class="evolars-btn-outline" style="padding: 6px 14px; font-size: 13px;">Entrar</a>
                        </t>
                        <t t-else="">
                            <div class="dropdown">
                                <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" style="color: #ffffff; text-decoration: none; font-size: 13px; font-weight: 600;">
                                    <span t-esc="request.env.user.name"/>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                    <li><a class="dropdown-item" href="/my/home">Minha Conta</a></li>
                                    <li><a class="dropdown-item" href="/slides">Meus Cursos</a></li>
                                    <li><hr class="dropdown-divider"/></li>
                                    <li><a class="dropdown-item" href="/web/session/logout?redirect=/slides">Terminar Sessão</a></li>
                                </ul>
                            </div>
                        </t>
                    </nav>
                </div>
            </header>
        </xpath>

        <xpath expr="//footer[@id='bottom']" position="replace">
            <footer id="bottom" class="evolars-footer-angola" data-name="Evolars Footer">
                <div class="evolars-footer-grid">
                    <div class="evolars-footer-brand">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <img src="/evolars_angola_theme/static/src/img/evolars_symbol_white.png" alt="Evolars Logo" style="height: 32px; width: auto;"/>
                            <h4 class="mb-0 text-white" style="font-weight: 800; letter-spacing: 0.16em;">EVOLARS ANGOLA</h4>
                        </div>
                        <p>
                            Iniciativa educacional de impacto social promovida pela Evolars. Democratizamos a capacitação prática em programação, engenharia de software e tecnologias de ponta em Angola por meio de cursos e materiais abertos em PDF.
                        </p>
                    </div>

                    <div class="evolars-footer-col">
                        <h5>Plataforma</h5>
                        <ul>
                            <li><a href="/slides">Cursos Disponíveis</a></li>
                            <li><a href="/slides/all">Catálogo &amp; Apostilas</a></li>
                            <li><a href="/web/login">Portal do Aluno</a></li>
                        </ul>
                    </div>

                    <div class="evolars-footer-col">
                        <h5>Evolars Global</h5>
                        <ul>
                            <li><a href="https://evolars.com.br" target="_blank" rel="noopener noreferrer">evolars.com.br ↗</a></li>
                            <li><a href="https://evolars.com.br/#solucoes" target="_blank" rel="noopener noreferrer">Soluções Corporativas ↗</a></li>
                            <li><a href="https://wa.me/5511930680941?text=Ol%C3%A1%2C%20Evolars!%20Gostaria%20de%20saber%20mais%20sobre%20o%20projeto%20Evolars%20Angola." target="_blank" rel="noopener noreferrer">Fale Conosco ↗</a></li>
                        </ul>
                    </div>
                </div>

                <div class="evolars-footer-bottom">
                    <span>© <t t-esc="datetime.date.today().year"/> Evolars Angola. Todos os direitos reservados.</span>
                    <span>Uma iniciativa <a href="https://evolars.com.br" target="_blank" rel="noopener noreferrer" style="color: var(--evolars-green); font-weight: 600; text-decoration: none;">Evolars LTDA</a></span>
                </div>
            </footer>
        </xpath>

        <xpath expr="//script[@id='tracking_code_config']" position="replace">
            <script id="tracking_code_config">
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('consent', 'default', {
                    'ad_storage': 'granted',
                    'ad_user_data': 'granted',
                    'ad_personalization': 'granted',
                    'analytics_storage': 'granted',
                });
                gtag('js', new Date());
                gtag('config', '<t t-esc="website.google_analytics_key"/>');
            </script>
        </xpath>
    </template>

    <template id="evolars_angola_courses_home_banner" inherit_id="website_slides.courses_home" name="Evolars Angola Hero Banner" priority="50">
        <xpath expr="//section[hasclass('s_banner')]" position="replace">
            <section class="evolars-hero-angola">
                <div class="evolars-hero-angola-content">
                    <div class="evolars-eyebrow">
                        <span class="fa fa-graduation-cap me-1"></span>
                        <span>Iniciativa Educacional de Tecnologia</span>
                    </div>
                    <h1 class="evolars-hero-title">
                        Capacitação Tecnológica em <em>Angola</em>
                    </h1>
                    <p class="evolars-hero-subtitle">
                        Cursos de programação, arquitetura de software e engenharia digital desenvolvidos pela Evolars. Acesse conteúdos práticos e materiais em PDF para impulsionar a sua carreira técnica.
                    </p>
                    <div class="evolars-badges-row">
                        <span class="evolars-pill-badge">
                            <span style="color: var(--evolars-green);">●</span> 100% Gratuito
                        </span>
                        <span class="evolars-pill-badge">
                            <span class="fa fa-file-pdf-o" style="color: var(--evolars-green);"></span> Materiais &amp; Apostilas em PDF
                        </span>
                        <span class="evolars-pill-badge">
                            <span class="fa fa-code" style="color: var(--evolars-green);"></span> Foco em Código Real
                        </span>
                        <span class="evolars-pill-badge">
                            <span class="fa fa-rocket" style="color: var(--evolars-green);"></span> Padrão de Engenharia Evolars
                        </span>
                    </div>
                    <div class="evolars-hero-actions">
                        <a href="/slides/all" class="evolars-btn-primary">
                            Ver Todas as Formações <span class="fa fa-arrow-right"></span>
                        </a>
                        <a href="https://evolars.com.br" target="_blank" rel="noopener noreferrer" class="evolars-btn-outline">
                            Conhecer a Evolars ↗
                        </a>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
