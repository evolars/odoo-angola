<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_evolars_email" model="ir.ui.view">
        <field name="name">res.partner.form.evolars.email</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_email_messages" type="object" class="oe_stat_button" icon="fa-envelope-o">
                    <field name="email_message_count" string="E-mails" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
