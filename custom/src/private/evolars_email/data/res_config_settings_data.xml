        <field name="key">resend.domain</field>
        <field name="value">c-edl.com</field>
    </record>

    <record id="param_resend_default_from" model="ir.config_parameter">
        <field name="key">resend.default_from</field>
        <field name="value">Secretaria C-EDL &lt;secretaria@c-edl.com&gt;</field>
    </record>

    <record id="param_resend_auto_create_partner_email" model="ir.config_parameter">
        <field name="key">resend.auto_create_partner_email</field>
        <field name="value">True</field>
    </record>
</odoo>
