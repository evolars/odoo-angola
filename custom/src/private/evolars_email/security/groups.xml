<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_evolars_email" model="ir.module.category">
        <field name="name">E-mail</field>
        <field name="description">Controle de acesso às caixas postais institucionais e correio eletrônico</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_evolars_email_user" model="res.groups">
        <field name="name">Usuário de E-mail</field>
        <field name="category_id" ref="module_category_evolars_email"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_evolars_email_manager" model="res.groups">
        <field name="name">Administrador de E-mails</field>
        <field name="category_id" ref="module_category_evolars_email"/>
        <field name="implied_ids" eval="[(4, ref('group_evolars_email_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
